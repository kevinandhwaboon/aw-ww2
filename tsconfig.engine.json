{
  // Rules engine, AIs + their tests, checked WITHOUT the DOM or any ambient types.
  // Any use of window, document, Phaser etc. inside src/engine fails here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/engine", "src/ai", "tests"],
  // Reads ui/style.css as text, which needs Vite's types; checked by tsconfig.json instead.
  "exclude": ["tests/pageColors.test.ts"]
}
