{
  // Rules engine, AIs + their tests, checked WITHOUT the DOM or any ambient types.
  // Any use of window, document, Phaser etc. inside src/engine fails here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/engine", "src/ai", "src/campaign", "tests"],
  // These read files through Vite (ui/style.css as text, unit sheet images, the sound files, the commander portraits), which needs Vite's types
  // and the DOM; checked by tsconfig.json instead.
  "exclude": ["tests/pageColors.test.ts", "tests/unitSheetImages.test.ts", "tests/soundFiles.test.ts", "tests/commanderPortraits.test.ts"]
}
